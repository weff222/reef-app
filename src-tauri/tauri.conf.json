  "productName": "TYPHON",
  "version": "1.5.0",
  "identifier": "com.reef.messenger",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "withGlobalTauri": true,
